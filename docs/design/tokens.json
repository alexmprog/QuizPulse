{
  "$schema": "quizpulse-design-tokens/v1",
  "source": "https://claude.ai/artifact/JvjAMCMeNBrzdayHAiNtCj",
  "themes": {
    "light": {
      "bg": "#F5F4FA",
      "surface": "#FFFFFF",
      "surface-2": "#EEECF5",
      "border": "#DEDAEA",
      "text": "#17141F",
      "muted": "#5D586C",
      "offline": "#767185",
      "accent": "#5B3BEF",
      "accent-hover": "#4B2BDB",
      "on-accent": "#FFFFFF",
      "accent-soft": "#ECE8FF",
      "success": "#12804F",
      "success-soft": "#E1F4EA",
      "danger": "#C9343A",
      "on-danger": "#FFFFFF",
      "danger-soft": "#FCE7E8",
      "warning": "#8F5B00",
      "warning-soft": "#FFF1CF",
      "scrim": "rgba(16,12,32,0.55)",
      "shadow": "0 1px 2px rgba(20,16,40,.06), 0 8px 24px rgba(20,16,40,.08)"
    },
    "dark": {
      "bg": "#100E17",
      "surface": "#1A1823",
      "surface-2": "#252231",
      "border": "#332F42",
      "text": "#F3F1FA",
      "muted": "#A7A2B8",
      "offline": "#85809A",
      "accent": "#8C74FF",
      "accent-hover": "#A18EFF",
      "on-accent": "#140C38",
      "accent-soft": "#261F47",
      "success": "#3CCB86",
      "success-soft": "#12301F",
      "danger": "#FF6B70",
      "on-danger": "#2B0A0C",
      "danger-soft": "#3B1A1D",
      "warning": "#F5C04A",
      "warning-soft": "#36290B",
      "scrim": "rgba(0,0,0,0.62)",
      "shadow": "0 1px 2px rgba(0,0,0,.4), 0 8px 24px rgba(0,0,0,.35)"
    }
  },
  "answerSlots": {
    "note": "Same in both themes. Option index i (0..3) maps to slot a..d. Colour is never the only cue: shape + text are always shown.",
    "a": { "color": "#D6383E", "on": "#FFFFFF", "shape": "triangle" },
    "b": { "color": "#2459D6", "on": "#FFFFFF", "shape": "diamond" },
    "c": { "color": "#F2B305", "on": "#1E1600", "shape": "circle" },
    "d": { "color": "#12805A", "on": "#FFFFFF", "shape": "square" },
    "trueFalse": { "true": "b", "false": "a" }
  },
  "medals": {
    "gold": { "color": "#E3A80F", "on": "#1E1600" },
    "silver": { "color": "#9AA3B2", "on": "#14161A" },
    "bronze": { "color": "#C0773F", "on": "#1E1000" }
  },
  "qr": { "module": "#000000", "background": "#FFFFFF", "quietZonePx": 14, "note": "QR is always black on white, in both themes" },
  "font": {
    "display": { "family": "Unbounded", "fallback": "system-ui, sans-serif", "weights": [500, 700, 800], "letterSpacing": "-0.01em", "lineHeight": 1.15 },
    "body": { "family": "Onest", "fallback": "system-ui, sans-serif", "weights": [400, 500, 600, 700], "lineHeight": 1.45 },
    "numbers": "font-variant-numeric: tabular-nums for scores, timers, PIN, counters",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&family=Unbounded:wght@500;700;800&display=swap"
  },
  "typeScale": {
    "studio": { "caption": 12, "hint": 13, "body": 15, "cardTitle": 18, "section": 20, "pageTitle": 28 },
    "host": {
      "baseViewport": "1280x720, scale proportionally (e.g. clamp/vw) on larger screens",
      "chrome": 16, "playerChip": 18, "optionText": 26, "questionText": 38, "questionTextShort": 48,
      "counter": 56, "timer": 56, "pin": 52, "pauseTitle": 72, "numericAnswer": 136
    },
    "player": { "hint": 13, "body": 16, "option": 20, "trueFalse": 28, "title": 28, "score": 56, "rank": 120 }
  },
  "space": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 24, "phone": 28, "pill": 999 },
  "control": {
    "height": { "sm": 36, "md": 44, "lg": 56, "xl": 64 },
    "minTouchTarget": 44,
    "focusRing": "0 0 0 3px var(--accent-soft) + border var(--accent)",
    "invalidRing": "0 0 0 3px var(--danger-soft) + border var(--danger)"
  },
  "layout": {
    "studio": { "sidebar": 240, "contentPaddingX": 40, "editorQuestionList": 280, "editorSettingsPanel": 300 },
    "host": { "headerHeight": 64, "controlBarHeight": 80, "paddingX": 32 },
    "player": { "designWidth": 375, "paddingX": 16 }
  }
}
