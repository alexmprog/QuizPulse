# Copy to .env for local development. Every credential below is an obvious local-only placeholder.
PORT=3000
# Address that phones/laptops on the LAN use to reach the web app; run tools/dev/lan-url.sh to get a suggestion.
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_USER=quizpulse
POSTGRES_PASSWORD=quizpulse-local-only
POSTGRES_DB=quizpulse
DATABASE_URL=postgres://quizpulse:quizpulse-local-only@localhost:15432/quizpulse

REDIS_URL=redis://localhost:16379

S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_ACCESS_KEY=quizpulse-local
S3_SECRET_KEY=quizpulse-local-only
S3_BUCKET=quizpulse-images

# At least 32 characters each.
SESSION_SECRET=local-dev-session-secret-change-me-0000
CSRF_SECRET=local-dev-csrf-secret-change-me-000000
COOKIE_SECURE=false
VALIDATE_RESPONSES=true
