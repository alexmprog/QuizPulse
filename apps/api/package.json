    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@quizpulse/api-types": "workspace:*",
    "@quizpulse/game-engine": "workspace:*",
    "@quizpulse/protocol": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.1",
    "bullmq": "6.4.0",
    "connect-redis": "10.0.0",
    "cookie-parser": "1.4.7",
    "csrf-csrf": "4.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-openapi-validator": "5.6.2",
    "express-session": "1.19.0",
    "ioredis": "6.0.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
